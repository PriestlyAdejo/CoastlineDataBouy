# Copy to .env next to this file. Values must match the MinIO server (docker/compose.backend.yml).

DATABASE_URL=postgresql+psycopg://nereus:nereus@127.0.0.1:5432/nereus

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false

# Local dev: same as MinIO container root (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in compose).
MINIO_ROOT_USER=MECH0073BUOYADMIN
MINIO_ROOT_PASSWORD=your-minio-root-password-here

# Or use a service account from the MinIO console instead:
# MINIO_ACCESS_KEY=...
# MINIO_SECRET_KEY=...

MINIO_BUCKET_RAW=nereus-raw-acoustic
MINIO_BUCKET_DERIVED=nereus-derived
MINIO_BUCKET_EXPORTS=nereus-exports
