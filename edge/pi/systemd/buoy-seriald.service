[Unit]
Description=Buoy UART ingest (single owner)
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=jason
Group=jason
WorkingDirectory=/home/jason/CoastlineDataBouy
EnvironmentFile=/etc/nereus-edge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jason/CoastlineDataBouy/.venv/bin/python -m buoy.services.seriald
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=multi-user.target

