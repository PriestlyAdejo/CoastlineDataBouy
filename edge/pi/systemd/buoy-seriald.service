[Unit]
Description=Buoy UART ingest (single owner)
After=local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/ssd/buoy

[Service]
Type=simple
User=buoy
Group=buoy
WorkingDirectory=/opt/buoy/CoastlineDataBouy
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/buoy/CoastlineDataBouy/.venv/bin/python -m buoy.services.seriald
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=multi-user.target

