[Unit]
Description=Buoy UART ingest (single owner)
After=local-fs.target
Wants=local-fs.target
RequiresMountsFor=@DATA_DIR@

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m buoy.services.seriald
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=multi-user.target
