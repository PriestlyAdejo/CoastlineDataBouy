[Unit]
Description=Buoy wave stats derive (batch)
After=local-fs.target
Wants=local-fs.target
RequiresMountsFor=@DATA_DIR@

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m buoy.services.wave_derive --window-s 1200
