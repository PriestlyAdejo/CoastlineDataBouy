[Unit]
Description=Buoy wave stats derive (batch)
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
User=jason
Group=jason
WorkingDirectory=/home/jason/CoastlineDataBouy
EnvironmentFile=/etc/nereus-edge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jason/CoastlineDataBouy/.venv/bin/python -m buoy.services.wave_derive --window-s 1200

