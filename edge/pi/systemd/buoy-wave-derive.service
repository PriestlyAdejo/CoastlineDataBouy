[Unit]
Description=Buoy wave stats derive (batch)
After=local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/ssd/buoy

[Service]
Type=oneshot
User=buoy
Group=buoy
WorkingDirectory=/opt/buoy/CoastlineDataBouy
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/buoy/CoastlineDataBouy/.venv/bin/python -m buoy.services.wave_derive --window-s 1200

