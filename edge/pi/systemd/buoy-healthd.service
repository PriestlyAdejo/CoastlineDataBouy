[Unit]
Description=Buoy health collector service
After=local-fs.target network-online.target
Wants=local-fs.target network-online.target
RequiresMountsFor=/mnt/ssd/buoy

[Service]
Type=simple
User=buoy
Group=buoy
WorkingDirectory=/opt/buoy/CoastlineDataBouy
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/buoy/CoastlineDataBouy/.venv/bin/python -m buoy.services.healthd
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
