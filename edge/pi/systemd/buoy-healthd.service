[Unit]
Description=Buoy health collector service
After=local-fs.target network-online.target
Wants=local-fs.target network-online.target
RequiresMountsFor=@DATA_DIR@

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m buoy.services.healthd
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
