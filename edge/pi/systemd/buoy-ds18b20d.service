[Unit]
Description=Buoy DS18B20 polling service
After=local-fs.target
Wants=local-fs.target
RequiresMountsFor=@DATA_DIR@

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m buoy.services.ds18b20d
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
