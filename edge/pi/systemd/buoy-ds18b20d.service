[Unit]
Description=Buoy DS18B20 polling service
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=jason
Group=jason
WorkingDirectory=/home/jason/CoastlineDataBouy
EnvironmentFile=/etc/nereus-edge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jason/CoastlineDataBouy/.venv/bin/python -m buoy.services.ds18b20d
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

