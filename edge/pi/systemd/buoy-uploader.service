[Unit]
Description=Buoy uploader (offline-first sync to backend)
After=network-online.target local-fs.target
Wants=network-online.target local-fs.target
RequiresMountsFor=@DATA_DIR@

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m buoy.services.uploader
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
