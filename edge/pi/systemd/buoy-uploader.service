[Unit]
Description=Buoy uploader (offline-first sync to backend)
After=network-online.target local-fs.target
Wants=network-online.target local-fs.target
RequiresMountsFor=/mnt/ssd/buoy

[Service]
Type=simple
User=buoy
Group=buoy
WorkingDirectory=/opt/buoy/CoastlineDataBouy
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/buoy/CoastlineDataBouy/.venv/bin/python -m buoy.services.uploader
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

