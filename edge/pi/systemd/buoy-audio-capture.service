[Unit]
Description=Buoy hydrophone audio capture (arecord chunking)
After=local-fs.target sound.target
Wants=local-fs.target sound.target

[Service]
Type=simple
User=buoy
Group=buoy
EnvironmentFile=-/etc/buoy/buoy.env
ExecStart=/usr/local/bin/buoy-audio-capture --chunk-s 900 --rate 96000 --channels 1 --format S24_LE
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target

