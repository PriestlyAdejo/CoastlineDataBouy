[Unit]
Description=Buoy hydrophone audio capture (arecord chunking)
After=network-online.target local-fs.target sound.target
Wants=network-online.target local-fs.target sound.target
RequiresMountsFor=/mnt/ssd/buoy

[Service]
Type=simple
User=buoy
Group=buoy
WorkingDirectory=/opt/buoy/CoastlineDataBouy
EnvironmentFile=/etc/buoy/buoy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/buoy/CoastlineDataBouy/.venv/bin/python -m buoy.services.audio_capture
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target

