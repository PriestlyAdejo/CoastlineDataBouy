[Unit]
Description=Buoy hydrophone audio capture (arecord chunking)
After=network-online.target local-fs.target sound.target
Wants=network-online.target local-fs.target sound.target
RequiresMountsFor=/mnt/harddrive

[Service]
Type=simple
User=jason
Group=jason
WorkingDirectory=/home/jason/CoastlineDataBouy
EnvironmentFile=/etc/nereus-edge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jason/CoastlineDataBouy/.venv/bin/python -m buoy.services.audio_capture
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target

