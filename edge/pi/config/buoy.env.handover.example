# Handover profile — fast intervals for Friday demo (copy to /etc/buoy/buoy.env)
BUOY_NODE_ID=ucl-buoy
BUOY_BACKEND_API_BASE=http://100.97.101.91:8000/v1
BUOY_UPLOAD_TOKEN=STRONG_UPLOAD_TOKEN_69420

BUOY_BASE_DIR=/var/lib/buoy
# Preferred SSD path; if the Pi mounts elsewhere use /mnt/harddrive/buoy or /mnt/harddrive
BUOY_DATA_DIR=/mnt/ssd/buoy

BUOY_SERIAL_PORT=/dev/ttyACM0
BUOY_SERIAL_AUTO_DETECT=true
BUOY_SERIAL_BAUD=115200

BUOY_GNSS_AUTO_DETECT=true
BUOY_GNSS_BAUD=9600
BUOY_ENABLE_LOCATION_IP_FALLBACK=true

BUOY_AUDIO_AUTO_DETECT=true
BUOY_AUDIO_SAMPLE_RATE=96000
BUOY_AUDIO_CHANNELS=2
BUOY_AUDIO_FORMAT=S32_LE
BUOY_AUDIO_CHUNK_S=60

BUOY_UPLOAD_INTERVAL_S=5
BUOY_HEALTH_INTERVAL_S=10
BUOY_ENV_INTERVAL_S=5
BUOY_GNSS_INTERVAL_S=2
BUOY_LOCATION_HEARTBEAT_INTERVAL_S=60
