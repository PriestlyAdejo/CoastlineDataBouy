{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nereus.local/v1/health_snapshot.json",
  "title": "HealthSnapshot (v1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "node_id": { "$ref": "_common.json#/$defs/NodeId" },
    "ts": { "$ref": "_common.json#/$defs/IsoTimestamp" },

    "status": { "$ref": "_common.json#/$defs/HealthStatus" },

    "pi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "mem_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "cpu_temp_c": { "type": "number" },
        "uptime_s": { "type": "integer", "minimum": 0 }
      }
    },

    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mount_ok": { "type": "boolean" },
        "mountpoint": { "type": "string" },
        "fs_type": { "type": "string" },
        "free_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      }
    },

    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "status": { "$ref": "_common.json#/$defs/HealthStatus" },
          "detail": { "type": "string" }
        },
        "required": ["name", "status"]
      }
    },

    "connectivity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tailscale_ok": { "type": "boolean" },
        "tailscale_ip": { "type": "string" },
        "internet_ok": { "type": "boolean" }
      }
    }
  },
  "required": ["schema_version", "node_id", "ts", "status"]
}

