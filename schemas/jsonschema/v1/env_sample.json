{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nereus.local/v1/env_sample.json",
  "title": "EnvSample (v1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "node_id": { "$ref": "_common.json#/$defs/NodeId" },
    "ts": { "$ref": "_common.json#/$defs/IsoTimestamp" },
    "source": { "type": "string", "enum": ["ds18b20", "arduino_hs300x", "pi_local"] },
    "water_temp_c": { "type": "number", "description": "External DS18B20 waterproof probe temperature." },
    "enclosure_temp_c": { "type": "number" },
    "enclosure_rh_pct": { "type": "number", "minimum": 0, "maximum": 100 }
  },
  "required": ["schema_version", "node_id", "ts", "source"]
}

