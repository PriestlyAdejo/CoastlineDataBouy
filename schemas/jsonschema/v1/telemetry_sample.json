{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nereus.local/v1/telemetry_sample.json",
  "title": "TelemetrySample (v1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "node_id": { "$ref": "_common.json#/$defs/NodeId" },
    "ts": { "$ref": "_common.json#/$defs/IsoTimestamp" },
    "source": { "type": "string", "enum": ["arduino_serial1", "pi_local"] },
    "seq": { "type": "integer", "minimum": 0, "description": "Monotonic sequence number (if available)." },
    "arduino_ms": { "type": "integer", "minimum": 0, "description": "Arduino millis() at sample time (if available)." },

    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onboard_temp_c": { "type": "number" },
        "onboard_rh_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },

    "imu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accel_mps2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"]
        },
        "gyro_rps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"]
        },
        "mag_ut": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"]
        }
      }
    },

    "battery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pack_v": { "type": "number" },
        "pack_a": { "type": "number" },
        "soc_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },

    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uart_ok": { "type": "boolean" },
        "uart_rx_rate_hz": { "type": "number", "minimum": 0 }
      }
    }
  },
  "required": ["schema_version", "node_id", "ts", "source"]
}

